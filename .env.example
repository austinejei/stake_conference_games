PORT=3000
# Generate a private random value of at least 32 characters; never commit it.
ADMIN_KEY=
# Approved ward names separated by |. Leave blank to offer Visitor only.
WARDS=
# Enable production only behind the selected HTTPS endpoint.
# NODE_ENV=production
# APP_ORIGIN=https://your-approved-domain.example
# DATA_DIR=/absolute/path/to/persistent-data
# Set both values to use Turso instead of the local SQLite database.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
